#N canvas 0 0 480 320 10;
#X obj 20 30 receive fromGUI;
#X obj 20 55 list trim;
#X obj 20 80 route /enableTilt;
#X msg 20 105 list /enableTiltScrub \$1;
#X obj 20 130 send toSystem;
#X obj 120 80 route /smoothing;
#X msg 120 105 list /smoothing \$1;
#X obj 120 130 send toSystem;
#X obj 260 30 receive /tiltValue;
#X msg 260 60 list /tiltMeter \$1;
#X obj 260 90 send toGUI;
#X obj 360 30 receive /smoothingApplied;
#X msg 360 60 list /smoothMeter \$1;
#X obj 360 90 send toGUI;
#X text 20 175 Tilt meter receives /tiltValue from the app.;
#X text 20 195 Smoothing meter receives /smoothingApplied from the app.;
#X text 20 220 If the meters move but the page does not,;
#X text 20 235 check the network address in MobMuPlat settings.;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X connect 1 0 5 0;
#X connect 2 0 3 0;
#X connect 3 0 4 0;
#X connect 5 0 6 0;
#X connect 6 0 7 0;
#X connect 8 0 9 0;
#X connect 9 0 10 0;
#X connect 11 0 12 0;
#X connect 12 0 13 0;
